extends pug/base

//- Служебное оглавление вёрстки: ссылки на все страницы src/*.pug.
//- Список собирает gulpfile.js (sitePages → locals.sitePages): название — из `- title = '...'` страницы,
//- новая страница появляется здесь сама. Главная сайта — home.html.

append vars
	- title = 'ARTLIGHT | Страницы вёрстки'
	- meta.description = 'Оглавление сверстанных страниц'
	- meta.viewport = 'width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover'
	- meta.formatDetection = 'telephone=no'

block content
	-
		// служебные страницы — в конце списка
		var servicePages = ['ui-kit']
		var pages = (typeof sitePages !== 'undefined' ? sitePages : []).slice().sort(function (a, b) {
			var rank = function (page) {
				if (page.name === 'home') return 0
				return servicePages.indexOf(page.name) === -1 ? 1 : 2
			}
			return rank(a) - rank(b) || a.title.localeCompare(b.title, 'ru')
		})

	main.pages.container
		h1.pages__title Страницы вёрстки
		p.pages__text Все сверстанные страницы ARTLIGHT. Список обновляется сам при сборке.

		ol.pages__list
			each page, index in pages
				li.pages__item(class=(servicePages.indexOf(page.name) !== -1 ? 'pages__item--service' : null))
					a.pages__link(href=page.url)
						span.pages__number= index + 1
						span.pages__name= page.title
						span.pages__file= page.url
