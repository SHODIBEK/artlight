//- Личный кабинет — профиль: десктоп node-id=129-11289, моб. node-id=129-12757;
//- вкладка «Контрагенты» (profile.html#counterparties) — десктоп node-id=129-12300, моб. node-id=129-13380;
//- редактирование контрагента (#counterparties/edit, новый — #counterparties/new; экраны вкладки — tabs.js) —
//- десктоп node-id=2-9929, моб. node-id=2-22498; «Контактные лица» (#contacts) — node-id=172-17772,
//- форма контактного лица (#contacts/edit, #contacts/new) — без макета, как у контрагентов;
//- «Адреса доставки» (#addresses) — node-id=172-17879, новый адрес (#addresses/new, #addresses/edit) — node-id=172-18111.
//- Вкладки — tabs.js (хеш = data-tab, у 1-й без хеша; последняя «крошка» — название вкладки), профиль — profile.js
- var page = data.profilePage
- var accountCurrent = page.url
- var managerClosedMobile = true

//- поле профиля. Просмотр — просто текст (подпись сверху, значение снизу, без линии; пустое — прочерк, пароли скрыты).
//- editable — поле открывается кнопкой «Редактировать данные» (profile.js); пустое — подпись на строке значения.
//- open — всегда открыто (формы контрагента / контактного лица, .is-editing у формы); required — красный кружок в подписи
mixin profileField(opts)
	- var o = opts
	- var locked = o.editable && !o.open
	label.profile-field(class=[o.cls, o.editable || o.open ? 'profile-field--editable' : null])
		if o.options
			select.profile-field__control(name=o.name disabled=(locked ? true : null) required=o.required data-editable=(locked ? '' : null))
				each option in o.options
					option(value=option selected=(option === o.value))= option
			+svg('select-chevron').profile-field__chevron
		else
			input.profile-field__control(
				type=(o.type || 'text')
				name=o.name
				value=o.value
				placeholder=(locked ? data.profilePage.profile.empty : ' ')
				autocomplete=o.autocomplete
				readonly=(o.open ? null : true)
				required=o.required
				inputmode=o.inputmode
				data-editable=(locked ? '' : null)
				data-empty=(locked ? data.profilePage.profile.empty : null)
			)
		span.profile-field__label
			| #{o.label}
			if o.required
				span.profile-field__required
		if o.type === 'password' && o.name
			button.profile-field__eye.js-password-toggle(type="button" aria-label="Показать пароль" aria-pressed="false" data-show="Показать пароль" data-hide="Скрыть пароль")
				+svg('eye').profile-field__eye-icon.profile-field__eye-icon--show
				+svg('eye-off').profile-field__eye-icon.profile-field__eye-icon--hide

//- строка таблицы (контрагенты, контактные лица, адреса): значения + «удалить» / «редактировать» (экран #<вкладка>/edit).
//- data-field ячейки — имя поля формы (list.cells; без него — поля формы в порядке колонок)
mixin profileRow(item, key, list)
	- var names = list.cells || list.form.fields.map(function (field) { return field.name })
	.profile-table__row(role="row")
		each value, index in item
			span.profile-table__cell(role="cell" data-field=names[index])= value
		span.profile-table__actions(role="cell")
			button.profile-table__action.js-profile-remove(type="button" aria-label=`${list.remove} ${item[0]}` data-label=list.remove)
				+svg('delete').profile-table__action-icon
			a.profile-table__action.js-profile-edit(href=`#${key}/edit` aria-label=`${list.edit} ${item[0]}` data-label=list.edit)
				+svg('pen').profile-table__action-icon

//- вкладка-список: заголовок, «Добавить…», таблица и экраны формы (tabs.js): #<вкладка>/edit — «редактировать» в строке
//- (profile.js подставляет значения ячеек в поля по data-field; по прямой ссылке — 1-я строка), #<вкладка>/new — «Добавить…».
//- Отправка — feedback-form.js (data-sent: fetch на action, при 2xx — событие form:sent → profile.js обновляет таблицу)
mixin profileList(key)
	- var list = page[key]
	- var form = list.form
	- var names = list.cells || form.fields.map(function (field) { return field.name })
	.profile__panel(id=`profile-${key}` role="tabpanel" aria-labelledby=`profile-tab-${key}` hidden)
		.profile__screen.js-tab-screen(data-screen="")
			h2.profile__title= list.title
			a.profile-add.js-profile-add(href=`#${key}/new`)
				+svg('add').profile-add__icon
				span= list.add
			.profile-table(class=list.tableCls)
				.profile-table__box.js-profile-list(role="table" aria-label=list.title)
					.profile-table__row.profile-table__row--head(role="row")
						each column in list.columns
							span.profile-table__cell(role="columnheader")= column
					each item in list.items
						+profileRow(item, key, list)
			//- строка новой записи — profile.js после сохранения формы
			template.js-profile-row
				+profileRow(names.map(function () { return '' }), key, list)

		each mode in ['edit', 'new']
			.profile__screen.js-tab-screen(data-screen=mode data-screen-title=form[mode].crumb hidden)
				form.profile-record.is-editing.js-feedback-form.js-profile-record(action=form.action method="post" novalidate data-validate=".profile-field__control" data-sent data-mode=mode)
					if mode === 'edit'
						input(type="hidden" name="id" value="1")
					.profile-record__head
						a.account-order__back.js-tab-back(href=`#${key}` aria-label=form.back)
							+svg('chevron-right').account-order__back-icon
						h3.profile-record__title= form[mode].title
					.profile-record__fields
						each field, index in form.fields
							- var column = names.indexOf(field.name)
							- var value = mode === 'edit' && column > -1 ? list.items[0][column] : (field.options ? field.options[0] : '')
							+profileField(Object.assign({}, field, { value: value, open: true }))
					.profile-record__buttons
						button.profile-form__edit.profile-record__save(type="submit")
							+svg('save').profile-form__edit-icon
							span= form.save
						a.profile-record__cancel.js-tab-back(href=`#${key}`)= form.cancel

section.listing-head.container
	+breadcrumbs(page.breadcrumbs).listing-head__breadcrumbs.js-tabs-crumbs
	h1.listing-head__title= data.accountPage.title

section.account.container
	include ../components/account-aside

	.account__content.profile.js-tabs(data-crumbs=".js-tabs-crumbs")
		.profile__tabs(role="tablist" aria-label=data.accountPage.title)
			each tab, index in page.tabs
				button.tab.js-tab(
					class=(index ? null : 'is-active')
					id=`profile-tab-${tab.id}`
					type="button"
					role="tab"
					aria-selected=(index ? 'false' : 'true')
					aria-controls=`profile-${tab.id}`
					tabindex=(index ? '-1' : null)
					data-tab=tab.id
				)
					span.tab__label= tab.label

		//- Профиль: моб. — заголовок и «Редактировать» в строку, поля в колонку (30);
		//- ≥ 768 — поля по 2 в ряд (20), кнопка под ними
		- var profile = page.profile
		form.profile__panel.profile-form.js-profile-form#profile-profile(action="#" method="post" novalidate role="tabpanel" aria-labelledby="profile-tab-profile")
			h2.profile__title.profile-form__title= profile.title
			.profile-form__fields
				+profileField({ name: 'type', label: profile.type.label, value: profile.type.value })
				+profileField({ name: 'email', type: 'email', label: profile.email.label, value: profile.email.value, autocomplete: 'email', editable: true })
				+profileField({ name: 'last_name', label: profile.lastName.label, value: profile.lastName.value, autocomplete: 'family-name', editable: true })
				+profileField({ name: 'first_name', label: profile.firstName.label, value: profile.firstName.value, autocomplete: 'given-name', editable: true })
				+profileField({ name: 'phone', type: 'tel', label: profile.phone.label, value: profile.phone.value, autocomplete: 'tel', editable: true })
				+profileField({ name: 'city', label: profile.city.label, value: profile.city.value, autocomplete: 'address-level2', editable: true })
				//- пароль в просмотре — точками (без name — не отправляется); при редактировании вместо него — новый пароль и подтверждение
				+profileField({ type: 'password', label: profile.passwordCurrent.label, value: profile.passwordCurrent.value, cls: 'profile-field--password-view' })
				+profileField({ name: 'password', type: 'password', label: profile.password, autocomplete: 'new-password', editable: true, cls: 'profile-field--password js-password' })
				+profileField({ name: 'password_confirm', type: 'password', label: profile.passwordConfirm, autocomplete: 'new-password', editable: true, cls: 'profile-field--password js-password' })
				+profileField({ name: 'site', type: 'url', label: profile.site, autocomplete: 'url', editable: true })
				+profileField({ name: 'activity', label: profile.activity.label, value: profile.activity.value, options: profile.activity.options, editable: true, cls: 'profile-field--select' })
			p.profile-form__error.js-profile-error(hidden)= profile.passwordMismatch
			button.profile-form__edit.js-profile-edit(type="button" data-edit=profile.edit data-save=profile.save)
				+svg('pen').profile-form__edit-icon.profile-form__edit-icon--edit
				+svg('save').profile-form__edit-icon.profile-form__edit-icon--save
				span.js-profile-edit-label= profile.edit

		//- Контрагенты (форма — десктоп node-id=2-9929, моб. 2-22498), контактные лица (таблица — node-id=172-17772,
		//- формы в макете нет — как у контрагентов), адреса доставки (таблица — 172-17879, форма — 172-18111):
		//- таблица шире колонки — прокрутка (< 1280 до краёв экрана)
		+profileList('counterparties')
		+profileList('contacts')

		+profileList('addresses')

include ../components/account-menu-panel
