//- «Восстановление пароля: письмо отправлено» — отдельная страница в оформлении входа (.auth), содержимое — из попапа
//- (десктоп node-id=145-15093, моб. node-id=145-15901). Сюда ведёт форма password-recovery.html после отправки.
- var sent = data.passwordSentPage

section.auth.container
	.auth__box
		h1.auth__title= sent.title
		p.auth__text= sent.text
		+button({ label: sent.button.name, href: sent.button.url }).auth__submit
		each link in sent.links
			a.auth__link.auth__link--back(href=link.url)= link.name
