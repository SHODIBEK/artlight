//- «Восстановление пароля: новый пароль» — отдельная страница в оформлении входа (.auth), содержимое — из попапа
//- (десктоп node-id=183-14748, моб. node-id=183-15154). Сюда ведёт ссылка из письма восстановления пароля.
//- Подключение (бэкенд): форма с data-redirect — feedback-form.js проверяет пароли (мин. 6 символов,
//- подтверждение — data-match="password") и отправляет её fetch'ем на action (POST: password, password_confirm;
//- токен из ссылки письма — добавить скрытым полем), при ответе 2xx переходит на data-redirect — вход (login.html);
//- action="#" — сразу переход.
- var password = data.passwordNewPage

//- пароль с кнопкой «показать / скрыть» (auth.js)
mixin passwordNewInput(name, placeholder, attrs)
	+input({ name: name, type: 'password', placeholder: placeholder, required: true, attrs: Object.assign({ autocomplete: 'new-password', minlength: 6 }, attrs) }).auth__input.js-password
		button.auth__eye.js-password-toggle(type="button" aria-label="Показать пароль" aria-pressed="false" data-show="Показать пароль" data-hide="Скрыть пароль")
			+svg('eye').auth__eye-icon.auth__eye-icon--show
			+svg('eye-off').auth__eye-icon.auth__eye-icon--hide

section.auth.container
	.auth__box
		h1.auth__title= password.title

		form.auth__form.js-feedback-form(action=password.action method="post" novalidate data-validate=".input__field" data-redirect=password.redirect)
			.auth__fields
				+passwordNewInput('password', password.fields.password)
				+passwordNewInput('password_confirm', password.fields.confirm, { 'data-match': 'password' })
			+button({ type: 'submit', label: password.submit }).auth__submit

		a.auth__link.auth__link--back(href=password.back.url)= password.back.name
