//- Личный кабинет — избранное: «Все товары» — десктоп node-id=129-16998, моб. node-id=129-18412;
//- «Группы товаров» (favorites.html#groups) — десктоп node-id=129-17803, моб. node-id=129-18935;
//- группа (favorites.html#groups/<id>, экран вкладки — tabs.js) — десктоп node-id=2-9677, моб. node-id=2-22254.
//- Вкладки — tabs.js (data-crumbs-all — название вкладки в крошках и у 1-й: «Избранное / Все товары»)
- var page = data.favoritesPage
- var accountCurrent = page.url
- var managerClosedMobile = true

section.listing-head.container
	+breadcrumbs(page.breadcrumbs).listing-head__breadcrumbs.js-tabs-crumbs
	h1.listing-head__title= data.accountPage.title

section.account.container
	include ../components/account-aside

	.account__content.favorites.js-tabs(data-crumbs=".js-tabs-crumbs" data-crumbs-all)
		h2.account__title= page.title

		.favorites__tabs(role="tablist" aria-label=page.title)
			each tab, index in page.tabs
				button.tab.js-tab(
					class=(index ? null : 'is-active')
					id=`favorites-tab-${tab.id}`
					type="button"
					role="tab"
					aria-selected=(index ? 'false' : 'true')
					aria-controls=`favorites-${tab.id}`
					tabindex=(index ? '-1' : null)
					data-tab=tab.id
				)
					span.tab__label= tab.label

		//- товары: сетка 2 / 3 (768+) / 4 (1600+); карточек 10 / 9 (768+) / 4 (1280+, как в макете — без пагинации)
		.favorites__panel#favorites-products(role="tabpanel" aria-labelledby="favorites-tab-products")
			.favorites__grid
				each item, index in page.products
					+productCard(item, index < 4)
			+pagination(page.pagination.current, page.pagination.total).favorites__pagination

		//- группы: карточки как на главной кабинета (1 / 2 (768+) / 3 (1600+)), формы добавления в макете нет.
		//- Карточка — ссылка на экран группы #groups/<id> (tabs.js): назад, название, меню «⋮», товары — сетка «Всех товаров»
		.favorites__panel#favorites-groups(role="tabpanel" aria-labelledby="favorites-tab-groups" hidden)
			.favorites__screen.js-tab-screen(data-screen="")
				a.profile-add(href="#")
					+svg('add').profile-add__icon
					span= page.add
				ul.favorites__groups
					each group in page.groups
						li
							a.account-card.account-card--group(href=`#groups/${group.id}`)
								+svg('box').account-card__icon
								span.account-card__text
									span.account-card__title= group.title
									span.account-card__note= group.text

			each group in page.groups
				.favorites__screen.js-tab-screen(data-screen=group.id data-screen-title=group.title hidden)
					.favorites-group
						a.account-order__back.js-tab-back(href="#groups" aria-label=page.groupBack)
							+svg('chevron-right').account-order__back-icon
						h3.favorites-group__title= group.title
						+dropdown({ cls: 'favorites-group__menu' })
							button.favorites-group__more.js-dropdown-toggle(type="button" aria-expanded="false" aria-label=page.groupMenu.label)
								+svg('dots-vertical').favorites-group__more-icon
							.dropdown__panel
								ul.filter-options.filter-options--links
									each action in page.groupMenu.items
										li.filter-options__item
											a.filter-options__link(href=action.href)= action.label
					.favorites__grid
						each item in group.products
							+productCard(item)
					+pagination(page.pagination.current, page.pagination.total).favorites__pagination

include ../components/account-menu-panel
