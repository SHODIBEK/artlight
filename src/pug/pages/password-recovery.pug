//- «Восстановление пароля» — отдельная страница в оформлении входа (.auth), содержимое — из попапа
//- (десктоп node-id=145-14641, моб. node-id=145-15496). «Забыли пароль?» на login.html ведёт сюда.
//- Подключение (бэкенд): форма с data-redirect — feedback-form.js после проверки почты отправляет её
//- fetch'ем на action (POST, поле email) и при ответе 2xx переходит на data-redirect — страницу «Письмо отправлено»
//- (password-sent.html; action="#" — сразу переход).
- var password = data.passwordPage

section.auth.container
	.auth__box
		h1.auth__title= password.title
		p.auth__text
			each line in password.text
				span.auth__line= line

		form.auth__form.js-feedback-form(action=password.action method="post" novalidate data-validate=".input__field" data-redirect=password.redirect)
			.auth__fields
				+input({ name: 'email', type: 'email', placeholder: 'Почта', required: true, ariaLabel: 'Почта', attrs: { autocomplete: 'email' } }).auth__input
			+button({ type: 'submit', label: password.submit }).auth__submit

		a.auth__link.auth__link--back(href=password.back.url)= password.back.name
