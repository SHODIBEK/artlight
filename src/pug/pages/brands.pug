//- «Продукция других производителей»: десктоп node-id=2-6908, моб. node-id=2-21042
- var page = data.brandsPage

section.listing-head.container
	+breadcrumbs(page.breadcrumbs).listing-head__breadcrumbs
	h1.listing-head__title= typo(page.title)
	//- табы фильтруют логотипы ниже (brands-filter.js)
	nav.brands-head__types(aria-label="Виды продукции")
		each type, index in page.types
			+tab(type.name, { active: index === 0 }).js-project-type.js-brands-type(data-value=type.id)
	p.brands-head__intro= typo(page.intro)

//- логотипы 142×85 (моб. 100×60): 2 / 4 (768+) / 7 (1280+) в ряд; 1-й ряд — без lazy
section.brands.container
	ul.brands__grid
		each brand, index in page.brands
			li.brands__item.js-brands-item(data-type=brand[2])
				a.brand-card(href=page.url)
					img.brand-card__logo(src=`${baseDir}images/brands/brand-${brand[1]}.webp` width="142" height="85" alt=brand[0] loading=(index < 7 ? null : 'lazy'))
					span.brand-card__name= typo(brand[0])
	p.brands__note= typo(page.note)

- var feedbackData = page.feedback
include ../sections/feedback
