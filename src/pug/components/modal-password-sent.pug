//- Попап «Восстановление пароля: письмо отправлено»: десктоп https://www.figma.com/design/BBlv4Y6Hjn3vuFhWGffGIm/art-light?node-id=145-14654
//- (окно 145-15093), моб. node-id=145-15509 (окно 145-15901). Окно — как у «Восстановления пароля» (.success--password).
//- Открывается после отправки формы «Восстановления пароля» (data-success="password-sent"); показ — password-sent.html.
//- Из своего кода — document.dispatchEvent(new CustomEvent('modal:open', { detail: { id: 'password-sent' } })).
//- Ссылки на вкладки входа / регистрации на странице входа закрывают попап и переключают вкладку (tabs.js, hashchange).
- var sent = data.passwordSentModal

.modal.js-modal(data-modal-id="password-sent" data-modal-open=(typeof passwordSentOpen !== 'undefined' && passwordSentOpen) role="dialog" aria-modal="true" aria-labelledby="password-sent-title" aria-hidden="true")
	.modal__dialog.modal__dialog--roomy
		button.modal__close.js-modal-close(type="button" aria-label="Закрыть")
			+svg('popup-close').modal__close-icon

		.success.success--password
			h2.success__title#password-sent-title= sent.title
			p.success__text= sent.text
			+button({ view: 'main', label: sent.button.name, href: sent.button.url }).success__button
			each link in sent.links
				a.success__back.js-modal-close(href=link.url)= link.name
