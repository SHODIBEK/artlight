//- Попап «Восстановление пароля»: десктоп https://www.figma.com/design/BBlv4Y6Hjn3vuFhWGffGIm/art-light?node-id=145-14202
//- (окно 145-14641), моб. node-id=145-15104 (окно 145-15496). Окно и заголовок — как у «Успешной отправки» (.success).
//- Открывается ссылкой «Забыли пароль?» (data-modal="password-recovery", login.pug); показ — password-recovery.html.
//- Подключение (бэкенд): форма с data-success="password-sent" — feedback-form.js после проверки почты отправляет её
//- fetch'ем на action (POST, поле email) и при ответе 2xx открывает попап «Письмо отправлено» (action="#" — сразу попап).
//- «Вернуться на страницу входа» закрывает попап (он открыт поверх страницы входа).
- var password = data.passwordModal

.modal.js-modal(data-modal-id="password-recovery" data-modal-open=(typeof passwordOpen !== 'undefined' && passwordOpen) role="dialog" aria-modal="true" aria-labelledby="password-title" aria-hidden="true")
	.modal__dialog.modal__dialog--roomy
		button.modal__close.js-modal-close(type="button" aria-label="Закрыть")
			+svg('popup-close').modal__close-icon

		.success.success--password
			h2.success__title#password-title= password.title
			p.success__text
				each line in password.text
					span.success__line= line
			form.success__form.js-feedback-form(action=password.action method="post" novalidate data-validate=".input__field" data-success="password-sent")
				+input({ name: 'email', type: 'email', placeholder: 'Почта', required: true, ariaLabel: 'Почта', attrs: { autocomplete: 'email' } })
				+button({ view: 'main', type: 'submit', label: password.submit }).success__button
			button.success__back.js-modal-close(type="button")= password.back
