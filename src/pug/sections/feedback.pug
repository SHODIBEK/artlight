//- Форма заявки. feedbackData — данные другой формы поверх data.home.feedback («О компании» — «Приглашаем к сотрудничеству»:
//- поля в 2 колонки, вид деятельности — select), feedbackId — якорь секции
- var feedback = Object.assign({}, data.home.feedback, typeof feedbackData !== 'undefined' ? feedbackData : {})
- var isCooperation = !!feedback.activities
//- «Приглашаем к сотрудничеству» (cooperation.html) — «ФИО», «Название компании», вид деятельности на всю ширину
//- Страница курса (course.html) — те же поля, курс (select) первым, без страны и города
- var isCourse = feedback.fields === 'course'
- var isPartner = feedback.fields === 'partner' || isCourse
//- «Работа у нас» (vacancies.html) — вакансия (select) на всю ширину, «Фамилия», «Имя», почта, телефон, сообщение
- var isVacancy = feedback.fields === 'vacancy'
section.feedback.js-lazy-bg(id=(typeof feedbackId !== 'undefined' ? feedbackId : null) class=[typeof compactSections !== 'undefined' && compactSections ? 'feedback--compact' : null, typeof sectionsGap !== 'undefined' && sectionsGap ? 'feedback--gap-' + sectionsGap : null, isCooperation ? 'feedback--cooperation' : null, isPartner ? 'feedback--partner' : null, isVacancy ? 'feedback--vacancy' : null])
	.container.feedback__container
		.feedback__intro
			h2.feedback__title= typo(feedback.title)
			if feedback.text
				p.feedback__text= typo(feedback.text)

		form.feedback__form.js-feedback-form(action=feedback.action method="post" enctype="multipart/form-data" novalidate)
			.feedback__fields
				if isCourse
					+input({ name: 'course', placeholder: feedback.activityPlaceholder, options: feedback.activities, value: feedback.activityValue }).feedback__input.feedback__input--select
					+input({ name: 'name', placeholder: 'ФИО', required: true, attrs: { autocomplete: 'name' } }).feedback__input
					+input({ name: 'company', placeholder: 'Название компании', attrs: { autocomplete: 'organization' } }).feedback__input
					+input({ name: 'phone', type: 'tel', required: true, attrs: { autocomplete: 'tel', class: 'js-phone' } }).feedback__input.feedback__input--phone
					+input({ name: 'email', type: 'email', placeholder: 'Почта', attrs: { autocomplete: 'email' } }).feedback__input
					+input({ name: 'comment', placeholder: 'Сообщение', textarea: true }).feedback__input.feedback__input--textarea
				else if isVacancy
					+input({ name: 'vacancy', placeholder: feedback.activityPlaceholder, options: feedback.activities }).feedback__input.feedback__input--select
					+input({ name: 'surname', placeholder: 'Фамилия', attrs: { autocomplete: 'family-name' } }).feedback__input
					+input({ name: 'name', placeholder: 'Имя', required: true, attrs: { autocomplete: 'given-name' } }).feedback__input
					+input({ name: 'email', type: 'email', placeholder: 'Почта', attrs: { autocomplete: 'email' } }).feedback__input
					+input({ name: 'phone', type: 'tel', required: true, attrs: { autocomplete: 'tel', class: 'js-phone' } }).feedback__input.feedback__input--phone
					+input({ name: 'comment', placeholder: 'Сообщение', textarea: true }).feedback__input.feedback__input--textarea
				else if isPartner
					+input({ name: 'name', placeholder: 'ФИО', required: true, attrs: { autocomplete: 'name' } }).feedback__input
					+input({ name: 'company', placeholder: 'Название компании', attrs: { autocomplete: 'organization' } }).feedback__input
					+input({ name: 'activity', placeholder: feedback.activityPlaceholder, options: feedback.activities }).feedback__input.feedback__input--select
					+input({ name: 'phone', type: 'tel', required: true, attrs: { autocomplete: 'tel', class: 'js-phone' } }).feedback__input.feedback__input--phone
					+input({ name: 'email', type: 'email', placeholder: 'Почта', attrs: { autocomplete: 'email' } }).feedback__input
					+input({ name: 'country', placeholder: 'Страна', attrs: { autocomplete: 'country-name' } }).feedback__input
					+input({ name: 'city', placeholder: 'Город', attrs: { autocomplete: 'address-level2' } }).feedback__input
					+input({ name: 'comment', placeholder: 'Сообщение', textarea: true }).feedback__input.feedback__input--textarea
				else if isCooperation
					//- порядок — моб. макета; на десктопе «Фамилия» перед «Имя» (order)
					+input({ name: 'name', placeholder: 'Имя', required: true, attrs: { autocomplete: 'given-name' } }).feedback__input
					+input({ name: 'surname', placeholder: 'Фамилия', attrs: { autocomplete: 'family-name' } }).feedback__input.feedback__input--surname
					+input({ name: 'company', placeholder: 'Компания', attrs: { autocomplete: 'organization' } }).feedback__input
					+input({ name: 'activity', placeholder: feedback.activityPlaceholder, options: feedback.activities }).feedback__input.feedback__input--select
					+input({ name: 'email', type: 'email', placeholder: 'Почта', attrs: { autocomplete: 'email' } }).feedback__input
					+input({ name: 'phone', type: 'tel', required: true, attrs: { autocomplete: 'tel', class: 'js-phone' } }).feedback__input.feedback__input--phone
					+input({ name: 'country', placeholder: 'Страна', attrs: { autocomplete: 'country-name' } }).feedback__input
					+input({ name: 'city', placeholder: 'Город', attrs: { autocomplete: 'address-level2' } }).feedback__input
					+input({ name: 'comment', placeholder: 'Сообщение', textarea: true }).feedback__input.feedback__input--textarea
				else
					+input({ name: 'name', placeholder: 'Имя', required: true, attrs: { autocomplete: 'name' } }).feedback__input
					+input({ name: 'phone', type: 'tel', required: true, attrs: { autocomplete: 'tel', class: 'js-phone' } }).feedback__input.feedback__input--phone
					+input({ name: 'email', type: 'email', placeholder: 'Почта', attrs: { autocomplete: 'email' } }).feedback__input
					+input({ name: 'comment', placeholder: 'Дополнительная информация', textarea: true }).feedback__input.feedback__input--textarea
				label.feedback__file
					input.feedback__file-input.js-feedback-file(type="file" name="files[]" multiple)
					+svg('attach').feedback__file-icon
					span.feedback__file-text.js-feedback-file-text(data-empty="Прикрепить файл") Прикрепить файл

			.feedback__agreements
				each item in feedback.agreements
					+checkbox({ name: item.name, value: 'y' }).checkbox--dark.feedback__checkbox
						span.checkbox__label= typo(item.text)

			+button({ view: 'main', type: 'submit', label: 'Отправить заявку' }).feedback__submit

		.feedback__social
			p.feedback__social-title= feedback.socialTitle
			ul.feedback__social-list
				each item in data.socials
					li
						a.feedback__social-link(href=item.url target="_blank" rel="noopener" aria-label=item.name)
							+svg(item.icon).feedback__social-icon
