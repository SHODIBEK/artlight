//- Вопрос / ответ: faqData = { title, items: [{ question, answer?, open? }], note, answer — абзацы ответа по умолчанию }
section.faq.container(class=(typeof compactSections !== 'undefined' && compactSections ? 'faq--compact' : null))
	h2.faq__title= faqData.title
	.faq__list.js-accordion(data-accordion-single)
		each item in faqData.items
			.faq__item.js-accordion-item(class=(item.open ? 'is-open' : null))
				button.faq__question.js-accordion-toggle(type="button" aria-expanded=(item.open ? 'true' : 'false'))
					span.faq__text= typo(item.question)
					+svg('plus').faq__icon.faq__icon--plus
					+svg('minus').faq__icon.faq__icon--minus
				.faq__answer.js-accordion-body
					.faq__inner
						each paragraph in (item.answer || faqData.answer)
							p.faq__paragraph= typo(paragraph)
	p.faq__note= typo(faqData.note)
