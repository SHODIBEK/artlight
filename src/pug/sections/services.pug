//- servicesOptions (необязательно): { mod, id, title, images } — «О компании»: заголовок, своя сетка ≥ 1280
//- и свои кадры фото на ней (images: mod карточки → images/about/<имя>.webp);
//- «Услуги»: extraItems — третий ряд (фото item.src → images/services/service-<src>.webp), button: false — без кнопки
- var servicesOpts = typeof servicesOptions !== 'undefined' ? servicesOptions : {}

mixin serviceItem(item)
	- var wideImage = servicesOpts.images && servicesOpts.images[item.mod]
	a.services__item(class=`services__item--${item.mod}` href=item.url)
		if item.src
			span.services__picture
				img.services__image(src=`${baseDir}images/services/service-${item.src}.webp` alt="" loading="lazy")
		else
			picture.services__picture
				source(media="(max-width: 767px)" srcset=`${baseDir}images/home/service-${item.image}-mobile@2x.webp`)
				if wideImage
					source(media="(min-width: 1280px)" srcset=`${baseDir}images/about/${wideImage}.webp`)
				img.services__image(src=`${baseDir}images/home/service-${item.image}${item.desktopSuffix ? '-desktop' : ''}@2x.webp` alt="" loading="lazy")
		span.services__body
			span.services__title= typo(item.title)
			span.services__text= typo(item.text)

section.services.container(class=(servicesOpts.mod ? `services--${servicesOpts.mod}` : null) id=servicesOpts.id)
	- var items = data.home.services.items
	if servicesOpts.title
		h2.services__heading= servicesOpts.title
	.services__row.services__row--top
		each item in items.slice(0, 4)
			+serviceItem(item)
	.services__row.services__row--bottom
		each item in items.slice(4)
			+serviceItem(item)
	if servicesOpts.extraItems
		.services__row.services__row--extra
			each item in servicesOpts.extraItems
				+serviceItem(item)

	if servicesOpts.button !== false
		+button({ view: 'main', label: data.home.services.button.label, href: data.home.services.button.url }).services__button
