//- Карточка статьи блога: фото с рубрикой, под ним заголовок и анонс.
//- defaults — общие тексты (data.blogPage: tag, name, text, url), если у item своих нет
mixin blogCard(item, defaults)
	- var d = defaults || {}
	a.blog-card(href=(item.url || d.url || '#'))&attributes(attributes)
		span.blog-card__picture(class=(item.shade ? 'blog-card__picture--shade' : null))
			img.blog-card__image(src=`${baseDir}images/projects/project-${item.image}.jpg` alt="" loading="lazy" draggable="false")
			span.blog-card__tag= item.tag || d.tag
		span.blog-card__name= typo(item.name || d.name)
		span.blog-card__text= typo(item.text || d.text)
