//- Товар корзины (cart.html, checkout.html). index — порядок: первое фото — первый экран (LCP), без lazy;
//- eager: false — страница, где список ниже первого экрана (оформление запроса)
mixin cartItem(item, index, opts)
	-
		var o = opts || {}
		var isEager = !index && o.eager !== false
		var money = (value) => value.toLocaleString('ru-RU').replace(/\s/g, ' ') + ' ₽'
	li.cart-item.js-cart-item(data-price=item.price)&attributes(attributes)
		.cart-item__picture
			img.cart-item__image(src=`${baseDir}images/cart/${item.image}.webp` width="160" height="160" alt=item.name)&attributes(isEager ? { fetchpriority: 'high' } : { loading: 'lazy' })
			+checkbox({ name: 'cart_item', value: String(item.id), checked: true, ariaLabel: 'Выбрать товар' }).cart-item__check.js-cart-check
		.cart-item__body
			.cart-item__top
				.cart-item__info
					p.cart-item__name= typo(item.name)
					p.cart-item__specs= item.specs
				//- «В избранное» убрана по просьбе заказчика (в макете есть)
				.cart-item__actions
					button.cart-item__action.js-cart-remove(type="button" aria-label="Удалить из корзины")
						+svg('cart-remove').cart-item__action-icon
			.cart-item__bottom
				p.cart-item__price.js-cart-item-price= money(item.price * item.count)
				.cart-item__counter
					button.cart-item__count-button.js-cart-minus(type="button" aria-label="Уменьшить количество" disabled=(item.count <= 1))
						+svg('cart-minus').cart-item__count-icon
					span.cart-item__count.js-cart-count(aria-live="polite")= item.count
					button.cart-item__count-button.js-cart-plus(type="button" aria-label="Увеличить количество")
						+svg('cart-plus').cart-item__count-icon

//- «Итого» (корзина, оформление запроса): товаров, сумма заказа, скидка (summary.discount, %), сумма с учётом скидки —
//- по выбранным товарам пересчитывает cart.js (data-discount). Суммы — с «₽» через неразрывный пробел. Заголовок — tag (h2 / h3)
mixin cartSummary(cart, opts)
	-
		var o = opts || {}
		var s = cart.summary
		var sum = cart.items.reduce((acc, item) => acc + item.price * item.count, 0)
		var count = cart.items.reduce((acc, item) => acc + item.count, 0)
		var discount = Math.round(sum * s.discount) / 100
		var num = (value) => value.toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).replace(/\s/g, ' ')
	aside.cart-summary.js-cart-summary(data-discount=s.discount)&attributes(attributes)
		#{o.tag || 'h2'}.cart-summary__title= s.title
		dl.cart-summary__list
			.cart-summary__item
				dt.cart-summary__label= s.goods
				dd.cart-summary__value.js-cart-total-count= count
			.cart-summary__item
				dt.cart-summary__label= s.sum
				dd.cart-summary__value.js-cart-sum= num(sum) + ' ₽'
			.cart-summary__item
				dt.cart-summary__label= s.discountLabel
				dd.cart-summary__value.js-cart-discount= num(discount) + ' ₽'
			.cart-summary__item
				dt.cart-summary__label= s.total
				dd.cart-summary__value.js-cart-total= num(sum - discount) + ' ₽'
		if block
			block
