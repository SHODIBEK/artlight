//- неразрывный пробел после коротких предлогов и союзов — как переносы в макете («по расчёту», «вне зависимости», «где и какое»)
-
	function typo(text) {
		return String(text).replace(/(?<=^|[\s ])(в|во|и|а|но|на|не|по|от|до|за|из|к|с|со|у|о|об|вне|вы|мы|для|без|при|над|под|про|что|как|где|или)\s/gi, '$1 ');
	}
